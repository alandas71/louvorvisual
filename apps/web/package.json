    "@louvorvisual/sync": "*",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
