# Exemplo de ambiente da API. Copiar para .env e preencher localmente.
# Não versionar valores reais.
NODE_ENV=development
LOUVORVISUAL_API_PORT=3021
# Origem do web autorizada a enviar cookies (usada na validação CSRF).
LOUVORVISUAL_PUBLIC_ORIGIN=http://localhost:3000
# MySQL 8+ — use URL codificada caso usuário ou senha tenham caracteres reservados.
LOUVORVISUAL_DATABASE_URL=mysql://louvorvisual:troque-esta-senha@localhost:3306/louvorvisual
# Segredos de sessão — gerar valores aleatórios por ambiente.
LOUVORVISUAL_ACCESS_SECRET=
LOUVORVISUAL_REFRESH_SECRET=
# Diretório privado, persistente e fora do conteúdo servido pelo web server.
LOUVORVISUAL_MEDIA_DIR=/var/lib/louvorvisual/media
# Duração do refresh em dias. Sessões expiradas serão eliminadas pelo job de retenção.
LOUVORVISUAL_SESSION_DAYS=30
# Limite absoluto de áudio: 100 MiB (também validado pelo contrato).
LOUVORVISUAL_MAX_ASSET_BYTES=104857600
# Retenção proposta: lixeira 30 dias, eventos/operações 180 dias, backup 30 dias.
LOUVORVISUAL_TRASH_RETENTION_DAYS=30
LOUVORVISUAL_SYNC_RETENTION_DAYS=180
LOUVORVISUAL_BACKUP_RETENTION_DAYS=30
# Compatibilidade: API aceita clientes dentro desta janela declarada.
LOUVORVISUAL_MIN_CLIENT_VERSION=0.1.0
LOUVORVISUAL_MAX_CLIENT_VERSION=0.1.x
